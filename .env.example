# Used by docker-compose.yml and docker-compose-dev.yml for variable substitution.
# Service settings live in backend/.env and ai_service/.env.

PROJECT_NAME=mental-health

# PostgreSQL container (DB_USER, DB_PASSWORD, DB_NAME, DB_PORT must match backend/.env)
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=mental_health
DB_PORT=5432

# Published ports
FRONTEND_PORT=80
BACKEND_PORT=8000
AI_SERVICE_PORT=8001

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# pgAdmin (docker-compose-dev.yml only)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# Docker image tag (docker-compose.yml only, set by the deploy)
IMAGE_TAG=latest
