PROJECT_NAME=mental-health

# development or production. Tests set ENVIRONMENT=testing themselves (pytest.ini),
# do not put it into the real .env.
ENVIRONMENT=development

# PostgreSQL (the backend builds the connection URL from these values)
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=db
DB_PORT=5432
DB_NAME=mental_health

REDIS_URL=redis://redis:6379/0

# Celery (worker and beat). The broker uses Redis database 1 so the task queue
# stays separate from the AI chat sessions in database 0.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TIMEZONE=Europe/Kyiv

# Auth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Use long random values (at least 32 characters): openssl rand -hex 32
SECRET_KEY_ACCESS=change_me_access_secret_at_least_32_characters
SECRET_KEY_REFRESH=change_me_refresh_secret_at_least_32_characters
JWT_SIGNING_ALGORITHM=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
# true in production (HTTPS only), false for local http
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000
ACCESS_COOKIE=access
REFRESH_COOKIE=refresh
ACCESS_PATH=/
REFRESH_PATH=/api/auth

# Contact form e-mails.
# Local development: Mailpit from docker-compose (web UI shows the letters), no TLS, no login.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true,
# SMTP_USERNAME and SMTP_FROM_EMAIL = the Gmail address, SMTP_PASSWORD = an app password.
CONTACT_SUPPORT_EMAIL=support@platform.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@platform.com
SMTP_USE_TLS=false

# Frontend pages the user returns to after a payment
SUCCESS_PAYMENTS_REDIRECT=http://localhost/payment/success
CANCEL_PAYMENTS_REDIRECT=http://localhost/payment/cancel
# Where to send the user when WayForPay returns without an orderReference (must not be empty)
NO_ORDER_REFERENCE_REDIRECT=http://localhost/payment/cancel

# Payment provider: stripe or wayforpay
PAYMENT_PROVIDER=wayforpay

# Stripe (required only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# WayForPay (required only when PAYMENT_PROVIDER=wayforpay).
# The values below are the public test merchant from the WayForPay documentation,
# they work only in test mode. Replace them with your own merchant for production.
WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_SECRET_KEY=flk3409refn54t54t*FNJRET
WAYFORPAY_MERCHANT_DOMAIN=www.market.ua
WAYFORPAY_API_ADDRESS=https://api.wayforpay.com/api
WAYFORPAY_VERSION=1
WAYFORPAY_CURRENCY=UAH
# Checkout page language: UA or EN
WAYFORPAY_LANGUAGE=UA
# Paths appended to PUBLIC_BASE_URL (WayForPay calls them after a payment)
WAYFORPAY_SERVICE_URL_PART=/api/payments/webhook/wayforpay
WAYFORPAY_RETURN_URL_PART=/api/payments/return/wayforpay
# Public address of this backend, without a trailing slash.
# WayForPay sends payment webhooks to PUBLIC_BASE_URL/api/payments/webhook/wayforpay,
# so it must be reachable from the internet (use a tunnel for local development).
PUBLIC_BASE_URL=http://localhost:8000
# WayForPay payouts: true = log a simulated payout instead of calling WayForPay
WAYFORPAY_SIMULATE_PAYOUTS=true

# Booking
# How long a slot is held while the client pays, and how far ahead a slot can be booked.
BOOKING_HOLD_MINUTES=20
BOOKING_HORIZON_DAYS=30

# Monthly payouts to psychologists
# A session counts as completed SESSION_DURATION_MIN minutes after its start time.
SESSION_DURATION_MIN=50
# Platform share of each booking price, in percent (1-100); the psychologist gets the rest.
PLATFORM_FEE_PERCENT=35

# Booking cancellation
# The client gets a full refund when cancelling at least this many hours before the session.
BOOKING_FREE_CANCEL_HOURS=24

# Avatars (sizes in bytes)
AVATAR_STORAGE_DIR=media/avatars
AVATAR_STORAGE_URL=/media/avatars/
# Largest uploaded file (20 MB), largest stored file (5 MB), largest image (4096 x 4096 pixels)
MAX_AVATAR_UPLOAD_SIZE=20971520
MAX_AVATAR_SIZE=5242880
MAX_AVATAR_PIXELS=16777216
