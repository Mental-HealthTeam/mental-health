PROJECT_NAME=mental-health

# PostgreSQL (the backend builds the connection URL from these values)
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=db
DB_PORT=5432
DB_NAME=mental_health

REDIS_URL=redis://redis:6379/0

# Celery (worker and beat). The broker uses Redis database 1 so the task queue
# stays separate from the AI chat sessions in database 0.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_TIMEZONE=Europe/Kyiv

# Auth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
SECRET_KEY_ACCESS=change_me_access_secret
SECRET_KEY_REFRESH=change_me_refresh_secret
JWT_SIGNING_ALGORITHM=HS256
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000

# Frontend pages the user returns to after a payment
SUCCESS_PAYMENTS_REDIRECT=http://localhost/payment/success
CANCEL_PAYMENTS_REDIRECT=http://localhost/payment/cancel

# Payment provider: stripe or wayforpay
PAYMENT_PROVIDER=stripe

# Stripe (required only when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# WayForPay (required only when PAYMENT_PROVIDER=wayforpay)
WAYFORPAY_MERCHANT_ACCOUNT=your_wayforpay_merchant_account
WAYFORPAY_SECRET_KEY=your_wayforpay_secret_key
WAYFORPAY_MERCHANT_DOMAIN=your-site-domain.example
# Public address of this backend, without a trailing slash.
# WayForPay sends payment webhooks to PUBLIC_BASE_URL/api/payments/webhook/wayforpay,
# so it must be reachable from the internet (use a tunnel for local development).
PUBLIC_BASE_URL=http://localhost:8000
# WayForPay payouts: true = log a simulated payout instead of calling WayForPay
WAYFORPAY_SIMULATE_PAYOUTS=true

# Monthly payouts to psychologists
# A session counts as completed SESSION_DURATION_MIN minutes after its start time.
SESSION_DURATION_MIN=50
# Platform share of each booking price, in percent; the psychologist gets the rest.
PLATFORM_FEE_PERCENT=35

# Booking cancellation
# The client gets a full refund when cancelling at least this many hours before the session.
BOOKING_FREE_CANCEL_HOURS=24
