# LLM providers. The chat endpoint currently uses Groq, so GROQ_API_KEY is required;
# the Gemini and xAI (Grok) keys are needed only if those clients are switched on.
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
XAI_API_KEY=your_xai_api_key

# Redis chat sessions
REDIS_URL=redis://redis:6379/0
# Session lifetime in seconds
SESSION_TTL=1800
# Maximum number of messages kept in one chat session
MAX_MESSAGES=30

# Allowed frontend and backend origins, comma separated
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8000
